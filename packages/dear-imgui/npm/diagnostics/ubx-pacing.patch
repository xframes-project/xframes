+/** Source-owned ordered retention. Eviction is explicit; snapshots cannot mutate it. */
+export class BoundedHistory<T> {
+  private slots: T[] = [];
+  private first = 0;
+  received = 0;
+  evicted = 0;
+
+  constructor(readonly capacity: number) {
+    if (!Number.isInteger(capacity) || capacity < 1) throw new Error("Invalid history capacity");
+  }
+
+  append(value: T): void {
+    this.received++;
+    if (this.slots.length < this.capacity) this.slots.push(value);
+    else {
+      this.slots[this.first] = value;
+      this.first = (this.first + 1) % this.capacity;
+      this.evicted++;
+    }
+  }
+
+  snapshot(): T[] {
+    return this.slots.slice(this.first).concat(this.slots.slice(0, this.first));
+  }
+
+  clear(): void {
+    this.slots = [];
+    this.first = 0;
+    this.received = 0;
+    this.evicted = 0;
+  }
+
+  get size(): number { return this.slots.length; }
+}
diff --git a/src/telemetry/ConsoleHistory.ts b/src/telemetry/ConsoleHistory.ts
new file mode 100644
index 0000000..a3754fc
--- /dev/null
+++ b/src/telemetry/ConsoleHistory.ts
@@ -0,0 +1,132 @@
+// Console retention is defined by complete wire frames and byte offsets, not UI ticks.
+const UBX_NAMES: Record<string, string> = {
+  "01:07": "NAV-PVT",
+  "01:35": "NAV-SAT",
+  "01:04": "NAV-DOP",
+  "01:03": "NAV-STATUS",
+  "0a:09": "MON-HW",
+  "0a:37": "MON-HW3",
+  "0a:38": "MON-RF",
+  "05:01": "ACK-ACK",
+  "05:00": "ACK-NAK",
+};
+
+function ubxName(cls: number, id: number): string {
+  const key = `${cls.toString(16).padStart(2, "0")}:${id.toString(16).padStart(2, "0")}`;
+  return UBX_NAMES[key] ?? `UBX-${key.toUpperCase()}`;
+}
+
+function formatHexDump(chunk: Buffer, offset: number): string {
+  let result = "";
+  for (let i = 0; i < chunk.length; i += 16) {
+    const addr = (offset + i).toString(16).padStart(8, "0");
+    const bytes = chunk.subarray(i, Math.min(i + 16, chunk.length));
+
+    let hex = "";
+    let ascii = "";
+    for (let j = 0; j < 16; j++) {
+      if (j === 8) hex += " ";
+      if (j < bytes.length) {
+        hex += bytes[j].toString(16).padStart(2, "0") + " ";
+        ascii += bytes[j] >= 0x20 && bytes[j] <= 0x7e ? String.fromCharCode(bytes[j]) : ".";
+      } else {
+        hex += "   ";
+        ascii += " ";
+      }
+    }
+
+    result += `${addr}  ${hex} |${ascii}|\n`;
+  }
+  return result;
+}
+
+export class ConsoleHistory {
+  private frameBuffer: Buffer = Buffer.alloc(0);
+  offset = 0;
+  text = "";
+  generation = 0;
+  receivedBytes = 0;
+  evictedCodeUnits = 0;
+  private appendText(text: string) {
+    this.text += text;
+    if (this.text.length > 65536) {
+      this.evictedCodeUnits += this.text.length - 32768;
+      this.text = this.text.slice(-32768);
+      this.generation++;
+    }
+  }
+  ingest(chunk: Buffer) {
+    this.receivedBytes += chunk.length;
+      this.frameBuffer = Buffer.concat([this.frameBuffer, chunk]);
+      const buf = this.frameBuffer;
+      let pos = 0;
+
+      while (pos < buf.length) {
+        // Find next UBX sync (0xB5 0x62)
+        let syncPos = -1;
+        for (let i = pos; i < buf.length - 1; i++) {
+          if (buf[i] === 0xb5 && buf[i + 1] === 0x62) {
+            syncPos = i;
+            break;
+          }
+        }
+
+        if (syncPos === -1) {
+          // No sync found — dump remaining, keep last byte if it could be start of sync
+          const keep = buf[buf.length - 1] === 0xb5 ? 1 : 0;
+          if (buf.length - keep > pos) {
+            this.appendText(
+              formatHexDump(buf.subarray(pos, buf.length - keep), this.offset),
+            );
+            this.offset += buf.length - keep - pos;
+          }
+          pos = buf.length - keep;
+          break;
+        }
+
+        // Dump non-UBX bytes before sync
+        if (syncPos > pos) {
+          this.appendText(
+            formatHexDump(buf.subarray(pos, syncPos), this.offset),
+          );
+          this.offset += syncPos - pos;
+          pos = syncPos;
+        }
+
+        // Need at least 6 bytes for header
+        if (pos + 6 > buf.length) break;
+
+        const cls = buf[pos + 2];
+        const id = buf[pos + 3];
+        const payloadLen = buf[pos + 4] | (buf[pos + 5] << 8);
+        const frameLen = payloadLen + 8;
+
+        // Need complete frame
+        if (pos + frameLen > buf.length) break;
+
+        // Complete frame — print separator header + hex dump
+        const name = ubxName(cls, id);
+        const separator = `\n──── ${name} [${cls.toString(16).padStart(2, "0")}:${id.toString(16).padStart(2, "0")}] ${payloadLen} bytes ────\n`;
+        const frame = buf.subarray(pos, pos + frameLen);
+        this.appendText(
+          separator + formatHexDump(frame, this.offset),
+        );
+        this.offset += frameLen;
+        pos += frameLen;
+      }
+
+      // Save unprocessed bytes
+      this.frameBuffer =
+        pos < buf.length ? Buffer.from(buf.subarray(pos)) : Buffer.alloc(0);
+  }
+  snapshot() { return { text: this.text, generation: this.generation }; }
+  get pendingBytes() { return this.frameBuffer.length; }
+  reset() {
+    this.frameBuffer = Buffer.alloc(0);
+    this.offset = 0;
+    this.text = "";
+    this.receivedBytes = 0;
+    this.evictedCodeUnits = 0;
+    this.generation++;
+  }
+}
diff --git a/src/telemetry/HardwareHistory.ts b/src/telemetry/HardwareHistory.ts
new file mode 100644
index 0000000..a88279a
--- /dev/null
+++ b/src/telemetry/HardwareHistory.ts
@@ -0,0 +1,59 @@
+import type { MonHw, MonHw3, MonRf } from "ubx-parser";
+import { BoundedHistory } from "./BoundedHistory";
+
+export interface RfStatusData {
+  noisePerMS: number;
+  agcCnt: number;
+  aStatus: number;
+  aPower: number;
+  jammingState: number;
+  jamInd: number;
+  rtcCalib?: boolean;
+  safeBoot?: boolean;
+  xtalAbsent?: boolean;
+}
+
+export interface HwStatusData {
+  hwVersion: string;
+  nPins: number;
+  rtcCalib: boolean;
+  safeBoot: boolean;
+  xtalAbsent: boolean;
+}
+
+export class HardwareHistory {
+  rf: RfStatusData | null = null;
+  hw: HwStatusData | null = null;
+  readonly jam = new BoundedHistory<{ sequence: number; x: number; y: number }>(3000);
+  private start: number | null = null;
+  private sequence = 0;
+  epoch = 0;
+
+  ingestHw(msg: MonHw, now: number): boolean {
+    if ("variant" in msg) return false;
+    this.rf = { noisePerMS: msg.noisePerMS, agcCnt: msg.agcCnt, aStatus: msg.aStatus,
+      aPower: msg.aPower, jammingState: msg.flags.jammingState, jamInd: msg.jamInd,
+      rtcCalib: msg.flags.rtcCalib, safeBoot: msg.flags.safeBoot, xtalAbsent: msg.flags.xtalAbsent };
+    if (this.start === null) this.start = now;
+    this.jam.append({ sequence: ++this.sequence, x: (now - this.start) / 1000, y: msg.jamInd });
+    return true;
+  }
+  ingestRf(msg: MonRf): boolean {
+    if ("variant" in msg || !msg.list?.length) return false;
+    const rf = msg.list[0];
+    this.rf = { noisePerMS: rf.noisePerMS, agcCnt: rf.agcCnt, aStatus: rf.antStatus,
+      aPower: rf.antPower, jammingState: rf.flags.jammingState, jamInd: rf.jamInd };
+    return true;
+  }
+  ingestHw3(msg: MonHw3): boolean {
+    if ("variant" in msg) return false;
+    this.hw = { hwVersion: msg.hwVersion, nPins: msg.nPins, rtcCalib: msg.flags.rctCalib,
+      safeBoot: msg.flags.safeBoot, xtalAbsent: msg.flags.xtalAbsent };
+    return true;
+  }
+  snapshot() { return { rf: this.rf, hw: this.hw, jam: this.jam.snapshot(), epoch: this.epoch }; }
+  reset() {
+    this.rf = null; this.hw = null; this.start = null;
+    this.jam.clear(); this.epoch++;
+  }
+}
diff --git a/src/telemetry/MessageHistory.ts b/src/telemetry/MessageHistory.ts
new file mode 100644
index 0000000..93ad20a
--- /dev/null
+++ b/src/telemetry/MessageHistory.ts
@@ -0,0 +1,43 @@
+import type { UbxMessage } from "ubx-parser";
+import { BoundedHistory } from "./BoundedHistory";
+
+export interface MessageRow {
+  timestamp: string;
+  name: string;
+  length: string;
+  // Arrival ordinal within the connection. The ordinary table keeps its three
+  // visible columns; this identity makes retained-source accounting unambiguous.
+  sequence: number;
+}
+interface Entry { message: UbxMessage; time: number; sequence: number; row?: MessageRow; }
+
+export class MessageHistory {
+  private entries = new BoundedHistory<Entry>(500);
+  private formatted = 0;
+  ingest(message: UbxMessage, time: number): void {
+    this.entries.append({ message, time, sequence: this.entries.received + 1 });
+  }
+  snapshot(): MessageRow[] {
+    return this.entries.snapshot().map(entry => {
+      if (!entry.row) {
+        const date = new Date(entry.time);
+        entry.row = {
+          timestamp: [date.getHours(), date.getMinutes(), date.getSeconds()]
+            .map(value => String(value).padStart(2, "0")).join(":")
+            + "." + String(date.getMilliseconds()).padStart(3, "0"),
+          name: entry.message.name, length: String(JSON.stringify(entry.message).length), sequence: entry.sequence,
+        };
+        this.formatted++;
+      }
+      return entry.row;
+    });
+  }
+  get received() { return this.entries.received; }
+  get evicted() { return this.entries.evicted; }
+  getDiagnostics() {
+    const retainedFormatted = this.entries.snapshot().filter(entry => entry.row !== undefined).length;
+    return { received: this.received, retained: this.entries.size, evicted: this.evicted,
+      formatted: this.formatted, evictedBeforeFormatting: this.evicted - (this.formatted - retainedFormatted) };
+  }
+  clear(): void { this.entries.clear(); this.formatted = 0; }
+}
