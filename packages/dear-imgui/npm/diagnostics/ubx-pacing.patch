new file mode 100644
index 0000000..c49cd7a
--- /dev/null
+++ b/src/telemetry/ArrivalWindow.ts
@@ -0,0 +1,23 @@
+/** Exact rolling one-second totals at the application's millisecond clock
+ * resolution. Storage is fixed even when a callback contains a large burst.
+ */
+export class ArrivalWindow {
+  private times = new Float64Array(1001).fill(-Infinity);
+  private values = new Float64Array(1001);
+  add(now: number, value = 1): void {
+    const time = Math.floor(now);
+    const slot = ((time % 1001) + 1001) % 1001;
+    if (this.times[slot] !== time) {
+      this.times[slot] = time;
+      this.values[slot] = 0;
+    }
+    this.values[slot] += value;
+  }
+  total(now: number): number {
+    let result = 0;
+    for (let i = 0; i < 1001; i++)
+      if (this.times[i] > Math.floor(now) - 1000 && this.times[i] <= Math.floor(now)) result += this.values[i];
+    return result;
+  }
+  clear(): void { this.times.fill(-Infinity); this.values.fill(0); }
+}
