diff --git a/src/hooks/useMapHistory.ts b/src/hooks/useMapHistory.ts
new file mode 100644
index 0000000..e3dcd2d
--- /dev/null
+++ b/src/hooks/useMapHistory.ts
@@ -0,0 +1,33 @@
+import { onPresentationStatus } from "../telemetry/connectionStatus";
+import { useEffect, useState } from "react";
+import { serialManager } from "../connection";
+import type { ConnectionStatus } from "../connection";
+import type { NavPvt } from "ubx-parser";
+import { BoundedHistory } from "../telemetry/BoundedHistory";
+import { presentation } from "../telemetry/presentation";
+
+export function useMapHistory() {
+  const [points, setPoints] = useState<{ lat: number; lon: number }[]>([]);
+  useEffect(() => {
+    const history = new BoundedHistory<{ lat: number; lon: number }>(1000);
+    let active = true;
+    const owner = presentation.register(() => setPoints(history.snapshot()), "map-trail");
+    const onPvt = (pvt: NavPvt) => {
+      if (!active || pvt.fixType < 2) return;
+      history.append({ lat: pvt.lat, lon: pvt.lon });
+      owner.request(pvt.iTOW);
+    };
+    const onStatus = (status: ConnectionStatus) => {
+      if (!active || status === "connected") return;
+      owner.cancel(); history.clear(); setPoints([]);
+    };
+    serialManager.on("NAV-PVT", onPvt);
+    const removeStatus = onPresentationStatus(onStatus);
+    return () => {
+      active = false; owner.dispose(); history.clear();
+      serialManager.off("NAV-PVT", onPvt);
+      removeStatus();
+    };
+  }, []);
+  return points;
+}
