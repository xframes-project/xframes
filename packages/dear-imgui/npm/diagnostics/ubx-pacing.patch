new file mode 100644
index 0000000..a42a7de
--- /dev/null
+++ b/src/telemetry/PositionHistory.ts
@@ -0,0 +1,67 @@
+import type { NavPvtData } from "../hooks/useNavPvt";
+import { BoundedHistory } from "./BoundedHistory";
+
+export interface PositionSample {
+  sequence: number;
+  lat: number;
+  lon: number;
+  hMSL: number;
+  gSpeed: number;
+  hAcc: number;
+  elapsedSec: number;
+}
+
+/** Ingest before presentation. Reset creates a new epoch, with no old sample replay. */
+export class PositionHistoryStore {
+  readonly positions = new BoundedHistory<PositionSample>(3000);
+  readonly trail = new BoundedHistory<PositionSample>(1000);
+  private start: number | null = null;
+  private sequence = 0;
+  resetCounter = 0;
+  received = 0;
+  filtered = 0;
+
+  ingest(pvt: NavPvtData, now: number): void {
+    this.received++;
+    if (pvt.fixType < 2) { this.filtered++; return; }
+    if (this.start === null) this.start = now;
+    const sample: PositionSample = { sequence: ++this.sequence, lat: pvt.lat, lon: pvt.lon,
+      hMSL: pvt.hMSL, gSpeed: pvt.gSpeed, hAcc: pvt.hAcc, elapsedSec: (now - this.start) / 1000 };
+    this.positions.append(sample);
+    this.trail.append(sample);
+  }
+
+  resetPosition(): void {
+    this.positions.clear();
+    this.start = null;
+    this.resetCounter++;
+  }
+
+  resetConnection(): void {
+    this.resetPosition();
+    this.trail.clear();
+    this.received = 0;
+    this.filtered = 0;
+  }
+
+  snapshot() {
+    const samples = this.positions.snapshot();
+    const count = samples.length;
+    const last = samples.at(-1);
+    const meanLat = count ? samples.reduce((sum, s) => sum + s.lat, 0) / count : 0;
+    const meanLon = count ? samples.reduce((sum, s) => sum + s.lon, 0) / count : 0;
+    const cosLat = Math.cos(meanLat * Math.PI / 180);
+    const scatterPoints = samples.map(s => ({ x: (s.lon - meanLon) * cosLat * 111320,
+      y: (s.lat - meanLat) * 111320 }));
+    const distances = scatterPoints.map(p => Math.hypot(p.x, p.y)).sort((a, b) => a - b);
+    return { samples, scatterPoints, sampleCount: count, elapsedSec: last?.elapsedSec ?? 0,
+      resetCounter: this.resetCounter,
+      latestAltitude: last ? { x: last.elapsedSec, y: last.hMSL / 1000 } : null,
+      latestSpeed: last ? { x: last.elapsedSec, y: last.gSpeed * 0.0036 } : null,
+      latestHAcc: last ? { x: last.elapsedSec, y: last.hAcc / 1000 } : null,
+      cepStats: count ? { cep50: distances[Math.floor(count * 0.5)],
+        cep95: distances[Math.floor(count * 0.95)],
+        meanHAcc: samples.reduce((sum, s) => sum + s.hAcc, 0) / count / 1000,
+        sampleCount: count } : null };
+  }
+}
diff --git a/src/telemetry/PublicationCadence.ts b/src/telemetry/PublicationCadence.ts
new file mode 100644
index 0000000..7fd5a5c
--- /dev/null
+++ b/src/telemetry/PublicationCadence.ts
@@ -0,0 +1,170 @@
+export const UI_UPDATE_RATES = [10, 20, 60] as const;
+export type UiUpdateRate = typeof UI_UPDATE_RATES[number];
+export const validateUiUpdateRate = (value: unknown): UiUpdateRate =>
+  value === 10 || value === 20 || value === 60 ? value : 20;
+
+export interface CadenceClock {
+  now(): number;
+  schedule(callback: () => void, delayMs: number): unknown;
+  cancel(handle: unknown): void;
+}
+
+const realClock: CadenceClock = {
+  now: () => performance.now(),
+  schedule: (callback, delay) => setTimeout(callback, delay),
+  cancel: (handle) => clearTimeout(handle as ReturnType<typeof setTimeout>),
+};
+
+export interface PublicationObservation {
+  label: string;
+  flush: number;
+  requestedAt: number;
+  firstPendingAt: number;
+  startedAt: number;
+  finishedAt: number;
+  sourceSample?: number;
+  coalesced: number;
+}
+interface Owner {
+  publish: () => void;
+  label: string;
+  requests: number;
+  coalesced: number;
+  publications: number;
+  cancelled: number;
+  firstPendingAt: number;
+  requestedAt: number;
+  sourceSample?: number;
+  pendingRequests: number;
+}
+
+/** One application timer; one pending bit per registered presentation owner.
+ * Source data belongs to the owners, never to this queue. A late tick flushes
+ * once, anchored to actual execution time. The drained queue owns no timer.
+ */
+export class PublicationCadence {
+  private owners = new Map<symbol, Owner>();
+  private observer: ((event: PublicationObservation) => void) | null = null;
+  private unpaced = false;
+  private pending = new Set<symbol>();
+  private timer: unknown = null;
+  private generation = 0;
+  private lastFlush = -Infinity;
+  private disposed = false;
+  private rate: UiUpdateRate;
+  private requests = 0;
+  private coalesced = 0;
+  private flushes = 0;
+  private publications = 0;
+  private cancelled = 0;
+
+  constructor(rate: unknown = 20, private clock: CadenceClock = realClock) {
+    this.rate = validateUiUpdateRate(rate);
+  }
+
+  register(publish: () => void, label = "presentation") {
+    if (this.disposed) throw new Error("Publication cadence is disposed");
+    const key = Symbol();
+    const owner: Owner = { publish, label, requests: 0, coalesced: 0, publications: 0,
+      cancelled: 0, firstPendingAt: 0, requestedAt: 0, pendingRequests: 0 };
+    this.owners.set(key, owner);
+    return {
+      request: (sourceSample?: number) => {
+        if (this.disposed || !this.owners.has(key)) return;
+        this.requests++; owner.requests++;
+        if (this.pending.has(key)) { this.coalesced++; owner.coalesced++; }
+        else { owner.firstPendingAt = this.clock.now(); owner.pendingRequests = 0; }
+        owner.requestedAt = this.clock.now(); owner.sourceSample = sourceSample; owner.pendingRequests++;
+        this.pending.add(key);
+        if (this.unpaced) { this.flushes++; this.publish(key); }
+        else this.schedule();
+      },
+      cancel: () => {
+        if (this.pending.delete(key)) { this.cancelled++; owner.cancelled++; }
+        if (!this.pending.size) this.cancelTimer();
+      },
+      dispose: () => {
+        if (this.pending.delete(key)) { this.cancelled++; owner.cancelled++; }
+        this.owners.delete(key);
+        if (!this.pending.size) this.cancelTimer();
+      },
+    };
+  }
+
+  setRate(value: unknown): void {
+    const rate = validateUiUpdateRate(value);
+    if (this.disposed || this.rate === rate) return;
+    this.rate = rate;
+    this.cancelTimer();
+    this.schedule();
+  }
+
+  private cancelTimer(): void {
+    ++this.generation;
+    if (this.timer !== null) this.clock.cancel(this.timer);
+    this.timer = null;
+  }
+
+  private schedule(): void {
+    if (this.disposed || this.timer !== null || !this.pending.size) return;
+    const generation = this.generation;
+    const delay = Math.max(0, this.lastFlush + 1000 / this.rate - this.clock.now());
+    this.timer = this.clock.schedule(() => {
+      if (this.disposed || generation !== this.generation) return;
+      this.timer = null;
+      // Timers can wake early; retain the lower-bound cadence guarantee.
+      if (this.clock.now() < this.lastFlush + 1000 / this.rate) {
+        this.schedule();
+        return;
+      }
+      const batch = [...this.pending];
+      this.lastFlush = this.clock.now();
+      this.flushes++;
+      for (const key of batch) {
+        this.publish(key);
+      }
+      this.schedule();
+    }, delay);
+  }
+
+  private publish(key: symbol): void {
+    const owner = this.owners.get(key);
+    if (!owner || !this.pending.delete(key)) return;
+    this.publications++; owner.publications++;
+    const observer = this.observer;
+    const event = observer ? { label: owner.label, flush: this.flushes,
+      requestedAt: owner.requestedAt, firstPendingAt: owner.firstPendingAt,
+      startedAt: this.clock.now(), finishedAt: 0, sourceSample: owner.sourceSample,
+      coalesced: owner.pendingRequests - 1 } : null;
+    owner.publish();
+    if (event) { event.finishedAt = this.clock.now(); observer!(event); }
+  }
+
+  // Diagnostic-only retention-correct control; not a persisted product setting.
+  // Select before App mount so a comparison cannot change policy mid-session.
+  setUnpacedForComparison(enabled: boolean): void {
+    if (this.owners.size || this.disposed) throw new Error("Select comparison policy before mounting telemetry");
+    this.unpaced = enabled;
+  }
+  observe(observer: ((event: PublicationObservation) => void) | null): void {
+    this.observer = observer;
+  }
+
+  getDiagnostics() {
+    return { rate: this.rate, unpaced: this.unpaced, observer: this.observer !== null, owners: this.owners.size, pending: this.pending.size,
+      timers: this.timer === null ? 0 : 1, requests: this.requests, coalesced: this.coalesced,
+      flushes: this.flushes, publications: this.publications, cancelled: this.cancelled,
+      disposed: this.disposed, ownerCounts: [...this.owners.values()].map(owner => ({
+        label: owner.label, requests: owner.requests, coalesced: owner.coalesced,
+        publications: owner.publications, cancelled: owner.cancelled })) };
+  }
+
+  dispose(): void {
+    this.disposed = true;
+    this.observer = null;
+    this.cancelled += this.pending.size;
+    this.pending.clear();
+    this.owners.clear();
+    this.cancelTimer();
+  }
+}
diff --git a/src/telemetry/connectionStatus.ts b/src/telemetry/connectionStatus.ts
new file mode 100644
index 0000000..4b3d782
--- /dev/null
+++ b/src/telemetry/connectionStatus.ts
@@ -0,0 +1,18 @@
+import { serialManager } from "../connection";
+import type { ConnectionStatus } from "../connection";
+
+// One connection listener for all presentation owners, removed with the last
+// subscription. Controls still receive the original event synchronously.
+const listeners = new Set<(status: ConnectionStatus) => void>();
+const dispatch = (status: ConnectionStatus) => {
+  for (const listener of [...listeners]) if (listeners.has(listener)) listener(status);
+};
+export function onPresentationStatus(listener: (status: ConnectionStatus) => void) {
+  if (!listeners.size) serialManager.on("status", dispatch);
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+    if (!listeners.size) serialManager.off("status", dispatch);
+  };
+}
+export const presentationStatusSubscriptions = () => listeners.size;
