new file mode 100644
index 0000000..88b4926
--- /dev/null
+++ b/src/telemetry/presentation.ts
@@ -0,0 +1,12 @@
+import { getConfig, updateConfig } from "../connection/config";
+import { PublicationCadence, validateUiUpdateRate } from "./PublicationCadence";
+
+// Every presentation subscription shares this queue. Its lifetime contains no
+// timer or listener when the App has released its registrations.
+export const presentation = new PublicationCadence(getConfig().uiUpdateRate);
+
+export function setUiUpdateRate(value: unknown): void {
+  const rate = validateUiUpdateRate(value);
+  updateConfig({ uiUpdateRate: rate });
+  presentation.setRate(rate);
+}
diff --git a/tests/config.ts b/tests/config.ts
new file mode 100644
index 0000000..de51c5d
--- /dev/null
+++ b/tests/config.ts
@@ -0,0 +1,39 @@
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { basename, dirname, join, resolve } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+const scratch = mkdtempSync(join(tmpdir(), "ubx-pacing-config-"));
+const configModule = pathToFileURL(resolve(root, "src/connection/config.ts")).href;
+const loader = pathToFileURL(resolve(root, "node_modules/tsx/dist/loader.mjs")).href;
+function run(update = "") {
+  const result = spawnSync(process.execPath, ["--import", loader, "--input-type=module", "--eval",
+    `import { getConfig, updateConfig } from ${JSON.stringify(configModule)}; ${update}; console.log(JSON.stringify(getConfig()));`],
+  { cwd: scratch, encoding: "utf8", windowsHide: true });
+  assert.equal(result.status, 0, result.stderr);
+  return JSON.parse(result.stdout);
+}
+try {
+  assert.equal(run().uiUpdateRate, 20, "missing configuration defaults to 20");
+  for (const invalid of [null, [], "invalid", { uiUpdateRate: "60" }, { uiUpdateRate: 0 }, { uiUpdateRate: 30 }]) {
+    writeFileSync(join(scratch, "config.json"), JSON.stringify(invalid));
+    assert.equal(run().uiUpdateRate, 20);
+  }
+  writeFileSync(join(scratch, "config.json"), JSON.stringify({ portPath: "SYNTHETIC", baudRate: 38400 }));
+  for (const rate of [10, 60, 20]) {
+    assert.equal(run(`updateConfig({ uiUpdateRate: ${rate} })`).uiUpdateRate, rate);
+    assert.equal(JSON.parse(readFileSync(join(scratch, "config.json"), "utf8")).uiUpdateRate, rate);
+    const restarted = run();
+    assert.equal(restarted.uiUpdateRate, rate, "ordinary exit persists the setting across processes");
+    assert.equal(restarted.baudRate, 38400);
+    assert.equal(restarted.portPath, "SYNTHETIC");
+  }
+  console.log("Configuration: invalid/default rates, all choices persisted across exit/restart, receiver settings preserved");
+} finally {
+  assert.equal(dirname(resolve(scratch)), resolve(tmpdir()));
+  assert.ok(basename(scratch).startsWith("ubx-pacing-config-"));
+  rmSync(scratch, { recursive: true });
+}
