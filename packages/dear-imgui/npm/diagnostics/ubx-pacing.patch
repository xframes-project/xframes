diff --git a/src/hooks/usePacedValue.ts b/src/hooks/usePacedValue.ts
new file mode 100644
index 0000000..5e1d888
--- /dev/null
+++ b/src/hooks/usePacedValue.ts
@@ -0,0 +1,39 @@
+import { onPresentationStatus } from "../telemetry/connectionStatus";
+import { useEffect, useState } from "react";
+import { serialManager } from "../connection";
+import { presentation } from "../telemetry/presentation";
+import type { ConnectionStatus } from "../connection";
+
+/** Latest-value displays only. Source histories subscribe before coalescing. */
+export function usePacedValue<T, M>(event: string, select: (message: M) => T) {
+  const [value, setValue] = useState<T | null>(null);
+  useEffect(() => {
+    let active = true;
+    let latest: M | null = null;
+    const owner = presentation.register(() => {
+      if (latest !== null) setValue(select(latest));
+      latest = null;
+    }, event);
+    const onMessage = (message: M) => {
+      if (!active) return;
+      latest = message;
+      owner.request(typeof (message as { iTOW?: number }).iTOW === "number" ? (message as { iTOW: number }).iTOW : undefined);
+    };
+    const onStatus = (status: ConnectionStatus) => {
+      if (!active || status === "connected") return;
+      latest = null;
+      owner.cancel();
+      setValue(null);
+    };
+    serialManager.on(event, onMessage);
+    const removeStatus = onPresentationStatus(onStatus);
+    return () => {
+      active = false;
+      latest = null;
+      owner.dispose();
+      serialManager.off(event, onMessage);
+      removeStatus();
+    };
+  }, [event, select]);
+  return value;
+}
