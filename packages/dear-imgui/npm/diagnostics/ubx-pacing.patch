+++ b/tests/parser-retention.ts
@@ -0,0 +1,106 @@
+import assert from "node:assert/strict";
+import { EventEmitter } from "node:events";
+import type { NavPvt, NavSat, MonHw } from "ubx-parser";
+import { SerialManager } from "../src/connection/SerialManager";
+import { PositionHistoryStore } from "../src/telemetry/PositionHistory";
+import { ConsoleHistory } from "../src/telemetry/ConsoleHistory";
+import { HardwareHistory } from "../src/telemetry/HardwareHistory";
+import { MessageHistory } from "../src/telemetry/MessageHistory";
+import { PublicationCadence, type CadenceClock } from "../src/telemetry/PublicationCadence";
+import { navPvtPacket, navSatPacket } from "./fixtures/ubx-bytes";
+
+class Port extends EventEmitter {
+  isOpen = true;
+  close() { this.isOpen = false; }
+  write() { return true; }
+}
+let time = 0, callback: (() => void) | null = null;
+const clock: CadenceClock = { now: () => time, schedule: cb => {
+  assert.equal(callback, null); callback = cb; return cb;
+}, cancel: () => { callback = null; } };
+const ports: Port[] = [];
+const manager = new SerialManager({ list: async () => [], open: (_options, ready) => {
+  const port = new Port(); ports.push(port); queueMicrotask(() => ready(null)); return port;
+} });
+const position = new PositionHistoryStore();
+const consoleHistory = new ConsoleHistory();
+const rows = new MessageHistory();
+const cadence = new PublicationCadence(20, clock);
+let published = position.snapshot(), latestSat = -1, latestPvt = -1;
+let satCount = 0, pvtCount = 0, messageCount = 0, rawBytes = 0;
+const owner = cadence.register(() => { published = position.snapshot(); });
+manager.on("NAV-PVT", (msg: NavPvt) => {
+  assert.equal(msg.iTOW / 50, ++pvtCount);
+  latestPvt = msg.iTOW / 50; position.ingest(msg, time); owner.request();
+});
+manager.on("NAV-SAT", (msg: NavSat) => {
+  assert.equal(msg.iTOW / 50, ++satCount); latestSat = msg.iTOW / 50;
+});
+manager.on("message", msg => { rows.ingest(msg, time); messageCount++; });
+manager.on("rawdata", chunk => { rawBytes += chunk.length; consoleHistory.ingest(chunk); });
+manager.connect("fixture", 38400);
+await new Promise<void>(done => queueMicrotask(done));
+for (let sequence = 1; sequence <= 7200; sequence++) {
+  const sat = navSatPacket(sequence), pvt = navPvtPacket(sequence);
+  if (sequence % 2) {
+    ports[0].emit("data", sat.subarray(0, 9));
+    ports[0].emit("data", Buffer.concat([sat.subarray(9), pvt]));
+  } else ports[0].emit("data", Buffer.concat([sat, pvt]));
+}
+assert.equal(published.sampleCount, 0);
+assert.equal(satCount, 7200); assert.equal(pvtCount, 7200); assert.equal(messageCount, 14400);
+assert.equal(rawBytes, 7200 * 164);
+assert.equal(consoleHistory.receivedBytes, rawBytes); assert.equal(consoleHistory.offset, rawBytes);
+assert.equal(consoleHistory.pendingBytes, 0);
+assert.deepEqual(rows.snapshot().map(row => [row.name, row.sequence]),
+  Array.from({ length: 500 }, (_, i) => [i % 2 ? "NAV-PVT" : "NAV-SAT", 13901 + i]));
+assert.equal(rows.evicted, 13900);
+assert.equal(rows.getDiagnostics().formatted, 500);
+assert.equal(rows.getDiagnostics().evictedBeforeFormatting, 13900);
+const cachedRows = rows.snapshot();
+assert.strictEqual(rows.snapshot()[0], cachedRows[0]);
+assert.equal(rows.getDiagnostics().formatted, 500);
+time = 100; const trailing = callback!; callback = null; trailing();
+assert.equal(published.sampleCount, 3000);
+assert.deepEqual(published.samples.map(s => s.hMSL), Array.from({ length: 3000 }, (_, i) => 54201 + i));
+assert.deepEqual(position.trail.snapshot().map(s => s.hMSL), Array.from({ length: 1000 }, (_, i) => 56201 + i));
+assert.equal(published.latestAltitude?.y, 57.2);
+assert.equal(latestPvt, 7200); assert.equal(latestSat, 7200);
+assert.equal(cadence.getDiagnostics().publications, 1);
+assert.equal(cadence.getDiagnostics().coalesced, 7199);
+manager.disconnect();
+position.resetConnection(); consoleHistory.reset(); rows.clear(); owner.cancel();
+const before = messageCount;
+ports[0].emit("data", navPvtPacket(7201));
+assert.equal(messageCount, before);
+assert.equal(position.positions.size, 0);
+assert.equal(consoleHistory.receivedBytes, 0);
+assert.equal(ports[0].eventNames().length, 0);
+manager.connect("fixture", 38400);
+await new Promise<void>(done => queueMicrotask(done));
+ports[1].emit("data", Buffer.concat([navSatPacket(7201), navPvtPacket(7201)]));
+assert.equal(position.positions.size, 1);
+assert.equal(position.snapshot().latestAltitude?.y, 57.201);
+const late = callback!;
+owner.dispose(); cadence.dispose(); late();
+assert.equal(published.sampleCount, 3000, "disposed publication cannot overwrite the last delivered view");
+manager.disconnect(); manager.removeAllListeners();
+assert.equal(callback, null);
+assert.ok(ports.every(port => !port.isOpen && !port.eventNames().length));
+
+const hardware = new HardwareHistory();
+const hw: MonHw = { name: "MON-HW", pinSel: 0, pinBank: 0, pinDir: 0, pinVal: 0,
+  noisePerMS: 10, agcCnt: 20, aStatus: 2, aPower: 1,
+  flags: { rtcCalib: true, safeBoot: false, jammingState: 1, xtalAbsent: false },
+  reserved1: 0, usedMask: 0, VP: Buffer.alloc(17), jamInd: 0, reserved2: 0, pinIrq: 0, pullH: 0, pullL: 0 };
+for (let i = 1; i <= 7200; i++) hardware.ingestHw({ ...hw, jamInd: i % 256 }, i * 10);
+assert.equal(hardware.jam.received, 7200); assert.equal(hardware.jam.evicted, 4200);
+assert.deepEqual(hardware.snapshot().jam.map(s => [s.sequence, s.y]),
+  Array.from({ length: 3000 }, (_, i) => [4201 + i, (4201 + i) % 256]));
+assert.equal(hardware.rf?.jamInd, 7200 % 256);
+hardware.reset(); hardware.ingestHw(hw, 100000);
+assert.equal(hardware.snapshot().jam[0].x, 0);
+assert.equal(hardware.jam.size, 1);
+console.log(JSON.stringify({ status: "passed", decodedPerType: 7201, messageCount, rawBytes,
+  retainedMessageRows: 500, retainedPositions: 3000, retainedTrail: 1000, hardwareRetained: 3000,
+  trailingPublicationsBeforeReconnect: 1, lateDeliveryRejected: true }));
