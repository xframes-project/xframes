@@ -0,0 +1,225 @@
+import assert from "node:assert/strict";
+import { PublicationCadence, validateUiUpdateRate, type CadenceClock } from "../src/telemetry/PublicationCadence";
+import { BoundedHistory } from "../src/telemetry/BoundedHistory";
+import { PositionHistoryStore } from "../src/telemetry/PositionHistory";
+import type { NavPvtData } from "../src/hooks/useNavPvt";
+import { ArrivalWindow } from "../src/telemetry/ArrivalWindow";
+import { ConsoleHistory } from "../src/telemetry/ConsoleHistory";
+import type { PublicationObservation } from "../src/telemetry/PublicationCadence";
+
+class Clock implements CadenceClock {
+  time = 0;
+  next = 0;
+  jobs = new Map<number, { at: number; callback: () => void }>();
+  now = () => this.time;
+  schedule(callback: () => void, delay: number) {
+    const id = ++this.next;
+    this.jobs.set(id, { at: this.time + delay, callback });
+    assert.ok(this.jobs.size <= 1, "shared cadence owns at most one timer");
+    return id;
+  }
+  cancel(id: unknown) { this.jobs.delete(id as number); }
+  advance(to: number) {
+    while (true) {
+      const next = [...this.jobs].sort((a, b) => a[1].at - b[1].at)[0];
+      if (!next || next[1].at > to) break;
+      this.time = next[1].at;
+      this.jobs.delete(next[0]);
+      next[1].callback();
+    }
+    this.time = to;
+  }
+}
+
+for (const value of [undefined, null, "10", 0, -1, 30, NaN, Infinity, {}, []])
+  assert.equal(validateUiUpdateRate(value), 20);
+
+for (const rate of [10, 20, 60] as const) {
+  const clock = new Clock();
+  const cadence = new PublicationCadence(rate, clock);
+  let source = 0;
+  const observed: { time: number; sample: number }[] = [];
+  const owner = cadence.register(() => observed.push({ time: clock.now(), sample: source }));
+  clock.advance(1000);
+  assert.equal(clock.jobs.size, 0, "no idle pacing");
+  for (let i = 0; i <= 240; i++) {
+    clock.advance(1000 + i * 1000 / 240);
+    source = i;
+    owner.request();
+  }
+  assert.ok(observed.length <= 1 + rate);
+  assert.ok(observed.length >= rate, "continuous source must actually publish");
+  clock.advance(2200);
+  assert.equal(observed.at(-1)!.sample, 240, "trailing sample requires no new input");
+  for (let i = 1; i < observed.length; i++)
+    assert.ok(observed[i].time - observed[i - 1].time >= 1000 / rate - 1e-9);
+  assert.equal(clock.jobs.size, 0);
+  const d = cadence.getDiagnostics();
+  assert.equal(d.requests, d.coalesced + d.publications);
+  owner.dispose();
+  assert.equal(cadence.getDiagnostics().owners, 0);
+}
+
+{
+  const clock = new Clock();
+  const cadence = new PublicationCadence(20, clock);
+  const seen: number[] = [];
+  const a = cadence.register(() => seen.push(clock.now()));
+  const b = cadence.register(() => seen.push(-clock.now()));
+  a.request(); b.request(); clock.advance(0);
+  assert.deepEqual(seen, [0, -0], "all owners share a tick");
+  clock.advance(10); a.request(); b.request();
+  const late = [...clock.jobs.values()][0].callback;
+  cadence.setRate(10);
+  late();
+  clock.advance(99); assert.equal(seen.length, 2);
+  clock.advance(100); assert.deepEqual(seen.slice(2), [100, -100]);
+  clock.advance(110); a.request(); cadence.setRate(60);
+  clock.advance(117); assert.equal(seen.at(-1), 100 + 1000 / 60);
+  a.request(); b.request();
+  // A blocked event loop runs the due timer once, without replaying missed ticks.
+  clock.time = 1000;
+  const delayed = [...clock.jobs.entries()][0];
+  clock.jobs.delete(delayed[0]); delayed[1].callback();
+  assert.equal(seen.at(-1), -1000);
+  assert.equal(clock.jobs.size, 0);
+  a.request(); b.request();
+  const afterDispose = [...clock.jobs.values()][0].callback;
+  const count = seen.length;
+  a.dispose(); b.dispose();
+  afterDispose(); a.request(); b.request();
+  assert.equal(seen.length, count);
+  assert.equal(clock.jobs.size, 0);
+  const fresh = cadence.register(() => seen.push(9999));
+  fresh.request(); fresh.cancel(); clock.advance(2000);
+  assert.equal(seen.length, count, "reset cancels pre-reset work");
+  fresh.request();
+  const afterTerminal = [...clock.jobs.values()][0].callback;
+  cadence.dispose(); afterTerminal(); fresh.request();
+  assert.equal(seen.length, count);
+  assert.equal(cadence.getDiagnostics().owners, 0);
+  assert.equal(clock.jobs.size, 0);
+}
+
+{
+  const history = new BoundedHistory<number>(500);
+  for (let i = 1; i <= 7200; i++) history.append(i);
+  assert.deepEqual(history.snapshot(), Array.from({ length: 500 }, (_, i) => 6701 + i));
+  assert.equal(history.received, 7200);
+  assert.equal(history.evicted, 6700);
+  history.snapshot().push(-1);
+  assert.equal(history.size, 500);
+  history.clear(); history.append(7201);
+  assert.deepEqual(history.snapshot(), [7201]);
+}
+
+{
+  const history = new PositionHistoryStore();
+  const clock = new Clock();
+  const cadence = new PublicationCadence(10, clock);
+  let snapshot = history.snapshot();
+  const owner = cadence.register(() => { snapshot = history.snapshot(); });
+  const packet = (i: number, fixType = 3): NavPvtData => ({ fixType, lat: 0,
+    lon: i / 111320, hMSL: i * 1000, hAcc: i * 1000, gSpeed: i,
+    height: 0, vAcc: 0, numSV: 4, year: 2026, month: 9, day: 11,
+    hour: 0, min: 0, sec: 0, tAcc: 0, heading: 0 });
+  for (let i = 1; i <= 7200; i++) {
+    history.ingest(packet(i), i);
+    owner.request();
+  }
+  history.ingest(packet(9999, 1), 7201);
+  assert.equal(snapshot.sampleCount, 0, "ingestion does not publish or derive snapshots");
+  clock.advance(0);
+  assert.deepEqual(snapshot.samples.map(s => s.sequence), Array.from({ length: 3000 }, (_, i) => 4201 + i));
+  assert.deepEqual(history.trail.snapshot().map(s => s.sequence), Array.from({ length: 1000 }, (_, i) => 6201 + i));
+  assert.equal(history.positions.evicted, 4200);
+  assert.equal(history.trail.evicted, 6200);
+  assert.equal(history.received, 7201);
+  assert.equal(history.filtered, 1);
+  assert.equal(snapshot.latestAltitude!.y, 7200);
+  assert.equal(snapshot.latestSpeed!.y, 7200 * 0.0036);
+  assert.equal(snapshot.latestHAcc!.y, 7200);
+  assert.equal(snapshot.cepStats!.meanHAcc, 5700.5);
+  assert.ok(Math.abs(snapshot.cepStats!.cep50 - 750.5) < 1e-8);
+  assert.ok(Math.abs(snapshot.cepStats!.cep95 - 1425.5) < 1e-8);
+  assert.equal(cadence.getDiagnostics().publications, 1);
+  assert.equal(cadence.getDiagnostics().coalesced, 7199);
+  history.ingest(packet(7201), 7300); owner.request();
+  owner.cancel(); history.resetPosition(); snapshot = history.snapshot();
+  clock.advance(200);
+  assert.equal(snapshot.sampleCount, 0);
+  assert.equal(history.trail.size, 1000, "Position reset preserves independent map trail");
+  history.ingest(packet(7202), 8000); owner.request(); clock.advance(201);
+  assert.equal(snapshot.sampleCount, 1);
+  assert.equal(snapshot.elapsedSec, 0);
+  assert.equal(snapshot.latestAltitude!.y, 7202);
+  history.resetConnection(); owner.cancel();
+  assert.equal(history.positions.size, 0);
+  assert.equal(history.trail.size, 0);
+  owner.dispose();
+}
+
+{
+  const window = new ArrivalWindow();
+  for (let i = 0; i < 10000; i++) window.add(0, 164);
+  window.add(999, 7);
+  assert.equal(window.total(999), 1640007);
+  assert.equal(window.total(1000), 7);
+  window.add(1001, 11);
+  assert.equal(window.total(1001), 18);
+  assert.equal(window.total(2001), 0);
+  window.add(10000, 9); window.clear();
+  assert.equal(window.total(10000), 0);
+}
+
+{
+  const console = new ConsoleHistory();
+  const ack = Buffer.from([0xb5, 0x62, 5, 1, 2, 0, 1, 7, 16, 52]);
+  let expected = "", evicted = 0;
+  for (let i = 0; i < 1000; i++) {
+    // Independent literal rendering oracle for this known frame.
+    const line = (i * 10).toString(16).padStart(8, "0")
+      + "  b5 62 05 01 02 00 01 07  10 34                    |.b.......4      |\n";
+    expected += "\n──── ACK-ACK [05:01] 2 bytes ────\n" + line;
+    if (expected.length > 65536) { evicted += expected.length - 32768; expected = expected.slice(-32768); }
+    console.ingest(ack.subarray(0, 3));
+    assert.equal(console.pendingBytes, 3);
+    console.ingest(ack.subarray(3));
+    assert.equal(console.pendingBytes, 0);
+  }
+  assert.equal(console.text, expected);
+  assert.equal(console.evictedCodeUnits, evicted);
+  assert.equal(console.offset, 10000);
+  assert.equal(console.receivedBytes, 10000);
+  console.ingest(ack.subarray(0, 5)); console.reset();
+  console.ingest(ack);
+  assert.equal(console.offset, 10);
+  assert.equal(console.pendingBytes, 0);
+  assert.ok(console.text.includes("00000000  b5 62"));
+}
+
+{
+  const clock = new Clock();
+  const cadence = new PublicationCadence(20, clock);
+  const events: PublicationObservation[] = [];
+  cadence.observe(event => events.push(event));
+  const owner = cadence.register(() => { clock.time += 2; }, "NAV-PVT");
+  owner.request(50); owner.request(100); clock.advance(0);
+  assert.equal(events.length, 1);
+  assert.equal(events[0].sourceSample, 100);
+  assert.equal(events[0].coalesced, 1);
+  assert.equal(events[0].finishedAt - events[0].startedAt, 2);
+  assert.throws(() => cadence.setUnpacedForComparison(true));
+  owner.dispose(); cadence.observe(null);
+  cadence.setUnpacedForComparison(true);
+  let publishes = 0;
+  const control = cadence.register(() => publishes++, "control");
+  for (let i = 0; i < 7200; i++) control.request(i);
+  assert.equal(publishes, 7200);
+  assert.equal(clock.jobs.size, 0);
+  assert.equal(cadence.getDiagnostics().ownerCounts[0].coalesced, 0);
+  control.dispose();
+  assert.equal(cadence.getDiagnostics().owners, 0);
+}
+
+console.log("Pacing and retention: all deterministic cadence, lifecycle, exact-tail and derived-statistics checks passed");
