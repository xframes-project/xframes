+import { EventEmitter } from "events";
+import { SerialPort } from "serialport";
+import type { SerialPortInfo } from "./types";
+
+export interface SerialTransportPort extends EventEmitter {
+  readonly isOpen: boolean;
+  close(callback?: (error: Error | null) => void): void;
+  write(data: Buffer): unknown;
+}
+
+// Only the byte transport varies. Connection state, parsing and subscriptions
+// remain owned by SerialManager. open's callback must run asynchronously.
+export interface SerialTransport {
+  list(): Promise<SerialPortInfo[]>;
+  open(options: { path: string; baudRate: number }, callback: (error: Error | null) => void): SerialTransportPort;
+}
+
+export const physicalSerialTransport: SerialTransport = {
+  list: () => SerialPort.list(),
+  open: (options, callback) => new SerialPort(options, callback),
+};
