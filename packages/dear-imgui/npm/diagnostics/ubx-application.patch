diff --git a/tests/serial-lifecycle.ts b/tests/serial-lifecycle.ts
new file mode 100644
index 0000000..43741fb
--- /dev/null
+++ b/tests/serial-lifecycle.ts
@@ -0,0 +1,71 @@
+import assert from "node:assert/strict";
+import { EventEmitter } from "node:events";
+import { SerialManager } from "../src/connection/SerialManager";
+import type { SerialTransport } from "../src/connection/SerialTransport";
+
+class Port extends EventEmitter {
+  isOpen = false;
+  close() { this.isOpen = false; queueMicrotask(() => this.emit("close")); }
+  write() { return true; }
+}
+const openings: { port: Port; complete: (error: Error | null) => void }[] = [];
+const transport: SerialTransport = {
+  list: async () => [{ path: "synthetic" }],
+  open: (_options, callback) => {
+    const port = new Port();
+    openings.push({ port, complete: (error) => { port.isOpen = !error; callback(error); } });
+    return port;
+  },
+};
+const manager = new SerialManager(transport);
+const errors: string[] = [];
+manager.on("error", (message) => errors.push(message));
+const statuses: string[] = [];
+manager.on("status", (status) => statuses.push(status));
+let messages = 0;
+manager.on("message", () => ++messages);
+// UBX ACK-ACK for NAV-PVT, with valid checksum. Generic delivery occurs once.
+const ack = Buffer.from([0xb5, 0x62, 5, 1, 2, 0, 1, 7, 16, 52]);
+manager.connect("synthetic", 38400);
+const first = openings[0];
+first.complete(null);
+first.port.emit("data", ack.subarray(0, 3));
+first.port.emit("data", ack.subarray(3));
+assert.equal(messages, 1);
+manager.disconnect();
+assert.deepEqual(first.port.eventNames(), []);
+assert.doesNotThrow(() => first.port.emit("data", ack));
+assert.equal(messages, 1);
+// A completion arriving after disconnect cannot publish connected state.
+manager.connect("synthetic", 38400);
+manager.disconnect();
+openings[1].complete(null);
+assert.equal(manager.getStatus(), "disconnected");
+assert.equal(openings[1].port.isOpen, false);
+// An old close or open completion must not affect a newer connection.
+manager.connect("synthetic", 38400);
+const pending = openings[2];
+manager.connect("synthetic", 38400);
+const current = openings[3];
+current.complete(null);
+pending.complete(null);
+first.port.emit("close");
+assert.equal(manager.getStatus(), "connected");
+assert.equal(pending.port.isOpen, false);
+current.port.emit("data", ack);
+assert.equal(messages, 2);
+// Exercise the actual delayed reconnect path, then release all ownership.
+current.port.isOpen = false;
+current.port.emit("close");
+assert.equal(manager.getStatus(), "reconnecting");
+await new Promise((done) => setTimeout(done, 2100));
+assert.equal(openings.length, 5);
+openings[4].complete(null);
+assert.equal(manager.getStatus(), "connected");
+openings[4].port.emit("data", ack);
+assert.equal(messages, 3);
+manager.disconnect();
+await new Promise((done) => setImmediate(done));
+assert.ok(openings.every(({ port }) => !port.isOpen && port.eventNames().length === 0));
+assert.deepEqual(errors, []);
+console.log(JSON.stringify({ status: "passed", openings: openings.length, messages, statuses, retainedPortListeners: 0 }));
